{
  "name": "@workspace/gate",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/dev.ts",
    "dev:api": "GATE_PORT=4101 bun --env-file=.env src/index.ts",
    "dev:client": "bun --bun vite dev --port 4100",
    "build": "vite build",
    "preview": "vite preview --port 4100",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.132.0",
    "@workspace/database": "workspace:*",
    "@workspace/document": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.6.9",
    "hono": "^4.12.18",
    "lucide-react": "^1.29.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.12",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
