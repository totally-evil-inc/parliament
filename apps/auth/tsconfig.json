{
  "include": ["**/*.ts", "../../packages/database/src/schema/auth-schema.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/database": ["../../packages/database/src/index.ts"],
      "@workspace/database/*": ["../../packages/database/src/*"],
      "@workspace/document": ["../../packages/document/src/index.ts"],
      "@workspace/document/*": ["../../packages/document/src/*"],
      "@workspace/agent": ["../../packages/agent/src/index.ts"],
      "@workspace/agent/*": ["../../packages/agent/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
