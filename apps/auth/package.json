{
  "name": "@workspace/auth",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=.env --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file=.env dist/index.js",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/database": "workspace:*",
    "better-auth": "^1.6.9",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.3.0",
    "@types/bun": "^1.3.12",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
