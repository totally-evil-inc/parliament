{
  "root": "Stack",
  "components": {
    "Stack": {
      "signature": "Stack(children: any[], direction?: \"row\" | \"column\", gap?: number, align?: \"start\" | \"center\" | \"end\" | \"stretch\", justify?: \"start\" | \"center\" | \"end\" | \"between\")",
      "description": "Flexible stack layout container for arranging elements horizontally or vertically."
    },
    "Layout": {
      "signature": "Layout(children: any[], type?: \"bento\" | \"grid\" | \"sidebar\", cols?: number)",
      "description": "Bento or grid layout container for structured dash cards and widgets."
    },
    "Content": {
      "signature": "Content(title?: string, subtitle?: string, body?: string)",
      "description": "Text content block with optional title, subtitle and body markdown."
    },
    "Data": {
      "signature": "Data(label: string, value: string, trend?: \"up\" | \"down\" | \"neutral\", badge?: string)",
      "description": "Key-value data tile with trend indicator or badge."
    },
    "EventCard": {
      "signature": "EventCard(summary: string, start: string, end?: string, location?: string, attendees?: string[], htmlLink?: string)",
      "description": "Calendar event badge displaying title, time range, attendees, and link."
    },
    "DocumentSentCard": {
      "signature": "DocumentSentCard(documentTitle: string, documentType: \"proposal\" | \"invoice\", shareUrl: string, recipientEmail?: string, status?: string, valueFormatted?: string)",
      "description": "Document dispatch card showing proposal or invoice sent status, share URL, and recipient."
    },
    "MetricGroup": {
      "signature": "MetricGroup(metrics: {label: string, value: string, change?: string}[])",
      "description": "Horizontal bar of 2 to 4 metric callouts."
    },
    "Chart": {
      "signature": "Chart(type?: \"bar\" | \"line\" | \"pie\", title?: string, data: Record<string, any>[], dataKeys?: string[])",
      "description": "Bar, line, or pie visualization chart."
    },
    "DataTable": {
      "signature": "DataTable(columns: {key: string, header: string}[], data: Record<string, any>[])",
      "description": "Structured data table with columns and rows."
    },
    "Callout": {
      "signature": "Callout(title?: string, description: string, variant?: \"info\" | \"success\" | \"warning\" | \"error\")",
      "description": "Important message callout box with severity color."
    },
    "LinkCard": {
      "signature": "LinkCard(title: string, description?: string, url: string, badge?: string)",
      "description": "External or internal link button card."
    },
    "Divider": {
      "signature": "Divider(label?: string)",
      "description": "Horizontal visual divider line with optional label."
    }
  },
