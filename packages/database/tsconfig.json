{
  "include": ["**/*.ts", "drizzle.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@workspace/database": ["./src/index.ts"],
      "@workspace/database/*": ["./src/*"],
      "@workspace/agent": ["../agent/src/index.ts"],
      "@workspace/agent/*": ["../agent/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "drizzle"]
}
